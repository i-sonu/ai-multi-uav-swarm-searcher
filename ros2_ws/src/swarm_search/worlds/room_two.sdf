<?xml version="1.0" ?>
<!--
  Two-drone room for coordinated exploration (milestone 6d).

  Same bounded room as room.sdf, now with TWO kinematic gpu_lidar drones
  (drone1, drone2) launched from a shared base in the lower area. A coordination
  node assigns them distinct frontiers so they split the room. All topics are
  namespaced by model name: /model/droneN/{scan,odometry,cmd_vel}.
-->
<sdf version="1.8">
  <world name="room_two">
    <physics name="1ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Outer boundary (16 x 16 m room), 0.5 m thick walls (= 2 grid cells). -->
    <model name="wall_n"><static>true</static><pose>0 8 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>16.5 0.5 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>16.5 0.5 1</size></box></geometry>
      <material><ambient>0.35 0.35 0.4 1</ambient><diffuse>0.35 0.35 0.4 1</diffuse></material></visual></link></model>
    <model name="wall_s"><static>true</static><pose>0 -8 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>16.5 0.5 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>16.5 0.5 1</size></box></geometry>
      <material><ambient>0.35 0.35 0.4 1</ambient><diffuse>0.35 0.35 0.4 1</diffuse></material></visual></link></model>
    <model name="wall_e"><static>true</static><pose>8 0 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.5 16.5 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.5 16.5 1</size></box></geometry>
      <material><ambient>0.35 0.35 0.4 1</ambient><diffuse>0.35 0.35 0.4 1</diffuse></material></visual></link></model>
    <model name="wall_w"><static>true</static><pose>-8 0 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.5 16.5 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.5 16.5 1</size></box></geometry>
      <material><ambient>0.35 0.35 0.4 1</ambient><diffuse>0.35 0.35 0.4 1</diffuse></material></visual></link></model>

    <!-- Internal walls. -->
    <model name="wall_div"><static>true</static><pose>0 2 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>10 0.5 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>10 0.5 1</size></box></geometry>
      <material><ambient>0.4 0.35 0.35 1</ambient><diffuse>0.4 0.35 0.35 1</diffuse></material></visual></link></model>
    <model name="wall_stub"><static>true</static><pose>-3 -4 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.5 6 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.5 6 1</size></box></geometry>
      <material><ambient>0.4 0.35 0.35 1</ambient><diffuse>0.4 0.35 0.35 1</diffuse></material></visual></link></model>

    <!-- Drone 1 (red), shared base in the open lower area. -->
    <model name="drone1">
      <pose>-1.5 -3.5 0.5 0 0 0</pose>
      <link name="base_link">
        <inertial><mass>1.0</mass>
          <inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.02</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.4 0.4 0.15</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 0.4 0.15</size></box></geometry>
          <material><ambient>0.85 0.15 0.15 1</ambient><diffuse>0.85 0.15 0.15 1</diffuse></material></visual>
        <sensor name="lidar" type="gpu_lidar">
          <pose>0 0 0.1 0 0 0</pose><topic>/model/drone1/scan</topic>
          <update_rate>10</update_rate><always_on>1</always_on><visualize>true</visualize>
          <lidar>
            <scan><horizontal><samples>360</samples><resolution>1</resolution>
              <min_angle>-3.141592653589793</min_angle><max_angle>3.141592653589793</max_angle></horizontal>
              <vertical><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></vertical></scan>
            <range><min>0.25</min><max>12.0</max><resolution>0.01</resolution></range>
          </lidar>
        </sensor>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/model/drone1/cmd_vel</topic></plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame><robot_base_frame>drone1</robot_base_frame>
        <dimensions>3</dimensions><odom_topic>/model/drone1/odometry</odom_topic>
        <odom_publish_frequency>30</odom_publish_frequency></plugin>
    </model>

    <!-- Drone 2 (blue), shared base in the open lower area. -->
    <model name="drone2">
      <pose>1.5 -3.5 0.5 0 0 0</pose>
      <link name="base_link">
        <inertial><mass>1.0</mass>
          <inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.02</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.4 0.4 0.15</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 0.4 0.15</size></box></geometry>
          <material><ambient>0.15 0.3 0.85 1</ambient><diffuse>0.15 0.3 0.85 1</diffuse></material></visual>
        <sensor name="lidar" type="gpu_lidar">
          <pose>0 0 0.1 0 0 0</pose><topic>/model/drone2/scan</topic>
          <update_rate>10</update_rate><always_on>1</always_on><visualize>true</visualize>
          <lidar>
            <scan><horizontal><samples>360</samples><resolution>1</resolution>
              <min_angle>-3.141592653589793</min_angle><max_angle>3.141592653589793</max_angle></horizontal>
              <vertical><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></vertical></scan>
            <range><min>0.25</min><max>12.0</max><resolution>0.01</resolution></range>
          </lidar>
        </sensor>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/model/drone2/cmd_vel</topic></plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame><robot_base_frame>drone2</robot_base_frame>
        <dimensions>3</dimensions><odom_topic>/model/drone2/odometry</odom_topic>
        <odom_publish_frequency>30</odom_publish_frequency></plugin>
    </model>
  </world>
</sdf>
