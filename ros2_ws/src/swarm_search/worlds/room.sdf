<?xml version="1.0" ?>
<!--
  A bounded multi-room building for autonomous exploration (milestones 6c/6d).

  ~36 x 36 m enclosed (outer walls at +/-18 m, ~5x the area of the original 16 m
  room) with several internal partition walls forming connected rooms and
  corridors, each with a doorway gap so frontier exploration can reach the whole
  space and terminate. Fits the mapping grid (240 cells @ 0.25 m = 60 m span,
  origin (-30,-30)). All walls 0.5 m thick (2 cells) so they map to solid,
  gap-free occupied lines. Same kinematic drone + gpu_lidar as before.
-->
<sdf version="1.8">
  <world name="room">
    <physics name="1ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Walls: pose (x y z r p yaw), size (sx sy sz). All 0.5 m thick. -->
    <!-- Outer boundary (36 x 36 m). -->
    <model name="wall_n"><static>true</static><pose>0 18 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>36.5 0.5 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>36.5 0.5 1</size></box></geometry>
      <material><ambient>0.35 0.35 0.4 1</ambient><diffuse>0.35 0.35 0.4 1</diffuse></material></visual></link></model>
    <model name="wall_s"><static>true</static><pose>0 -18 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>36.5 0.5 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>36.5 0.5 1</size></box></geometry>
      <material><ambient>0.35 0.35 0.4 1</ambient><diffuse>0.35 0.35 0.4 1</diffuse></material></visual></link></model>
    <model name="wall_e"><static>true</static><pose>18 0 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.5 36.5 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.5 36.5 1</size></box></geometry>
      <material><ambient>0.35 0.35 0.4 1</ambient><diffuse>0.35 0.35 0.4 1</diffuse></material></visual></link></model>
    <model name="wall_w"><static>true</static><pose>-18 0 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.5 36.5 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.5 36.5 1</size></box></geometry>
      <material><ambient>0.35 0.35 0.4 1</ambient><diffuse>0.35 0.35 0.4 1</diffuse></material></visual></link></model>

    <!-- Internal partitions (each leaves a doorway gap so all rooms connect). -->
    <!-- Vertical wall at x=-6, y in [-18, 4] (gap at top). -->
    <model name="wall_v1"><static>true</static><pose>-6 -7 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.5 22 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.5 22 1</size></box></geometry>
      <material><ambient>0.4 0.35 0.35 1</ambient><diffuse>0.4 0.35 0.35 1</diffuse></material></visual></link></model>
    <!-- Vertical wall at x=6, y in [-4, 18] (gap at bottom). -->
    <model name="wall_v2"><static>true</static><pose>6 7 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.5 22 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.5 22 1</size></box></geometry>
      <material><ambient>0.4 0.35 0.35 1</ambient><diffuse>0.4 0.35 0.35 1</diffuse></material></visual></link></model>
    <!-- Horizontal wall at y=6, x in [-18, 6] (gap on the right). -->
    <model name="wall_h1"><static>true</static><pose>-6 6 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>24 0.5 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>24 0.5 1</size></box></geometry>
      <material><ambient>0.4 0.35 0.35 1</ambient><diffuse>0.4 0.35 0.35 1</diffuse></material></visual></link></model>
    <!-- Horizontal wall at y=-6, x in [-6, 18] (gap on the left). -->
    <model name="wall_h2"><static>true</static><pose>6 -6 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>24 0.5 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>24 0.5 1</size></box></geometry>
      <material><ambient>0.4 0.35 0.35 1</ambient><diffuse>0.4 0.35 0.35 1</diffuse></material></visual></link></model>
    <!-- Two short interior obstacles to break up the big rooms. -->
    <model name="wall_o1"><static>true</static><pose>-12 -12 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>8 0.5 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>8 0.5 1</size></box></geometry>
      <material><ambient>0.4 0.35 0.35 1</ambient><diffuse>0.4 0.35 0.35 1</diffuse></material></visual></link></model>
    <model name="wall_o2"><static>true</static><pose>12 12 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.5 8 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.5 8 1</size></box></geometry>
      <material><ambient>0.4 0.35 0.35 1</ambient><diffuse>0.4 0.35 0.35 1</diffuse></material></visual></link></model>

    <!-- Drone (kinematic, gpu_lidar). Starts in the lower-central room. -->
    <model name="drone1">
      <pose>0 -3 0.5 0 0 0</pose>
      <link name="base_link">
        <inertial><mass>1.0</mass>
          <inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.02</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.4 0.4 0.15</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 0.4 0.15</size></box></geometry>
          <material><ambient>0.85 0.15 0.15 1</ambient><diffuse>0.85 0.15 0.15 1</diffuse></material></visual>
        <sensor name="lidar" type="gpu_lidar">
          <pose>0 0 0.1 0 0 0</pose>
          <topic>/model/drone1/scan</topic>
          <update_rate>10</update_rate><always_on>1</always_on><visualize>true</visualize>
          <lidar>
            <scan><horizontal><samples>360</samples><resolution>1</resolution>
              <min_angle>-3.141592653589793</min_angle><max_angle>3.141592653589793</max_angle></horizontal>
              <vertical><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></vertical></scan>
            <range><min>0.25</min><max>12.0</max><resolution>0.01</resolution></range>
          </lidar>
        </sensor>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/model/drone1/cmd_vel</topic>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame><robot_base_frame>drone1</robot_base_frame>
        <dimensions>3</dimensions><odom_topic>/model/drone1/odometry</odom_topic>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
    </model>
  </world>
</sdf>
