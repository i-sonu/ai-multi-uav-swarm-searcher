<?xml version="1.0" ?>
<!--
  A bounded room for autonomous exploration (milestones 6c/6d).

  An ~16 x 16 m enclosed room (outer walls at +/-8 m) with a few internal walls
  forming rooms/corridors, so frontier-based exploration has a finite space to
  cover and actually terminates. One (or, in 6d, two) LiDAR drones start near the
  centre. Same kinematic drone + gpu_lidar as the 6a/6b world.
-->
<sdf version="1.8">
  <world name="room">
    <physics name="1ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Walls: name, pose (x y z r p yaw), size (sx sy sz). Reused snippet. -->
    <!-- Outer boundary (16 x 16 m room). -->
    <model name="wall_n"><static>true</static><pose>0 8 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>16.4 0.2 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>16.4 0.2 1</size></box></geometry>
      <material><ambient>0.35 0.35 0.4 1</ambient><diffuse>0.35 0.35 0.4 1</diffuse></material></visual></link></model>
    <model name="wall_s"><static>true</static><pose>0 -8 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>16.4 0.2 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>16.4 0.2 1</size></box></geometry>
      <material><ambient>0.35 0.35 0.4 1</ambient><diffuse>0.35 0.35 0.4 1</diffuse></material></visual></link></model>
    <model name="wall_e"><static>true</static><pose>8 0 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.2 16 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 16 1</size></box></geometry>
      <material><ambient>0.35 0.35 0.4 1</ambient><diffuse>0.35 0.35 0.4 1</diffuse></material></visual></link></model>
    <model name="wall_w"><static>true</static><pose>-8 0 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.2 16 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 16 1</size></box></geometry>
      <material><ambient>0.35 0.35 0.4 1</ambient><diffuse>0.35 0.35 0.4 1</diffuse></material></visual></link></model>

    <!-- Internal walls: a partial divider (with a doorway gap) and a stub. -->
    <model name="wall_div"><static>true</static><pose>0 2 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>10 0.2 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>10 0.2 1</size></box></geometry>
      <material><ambient>0.4 0.35 0.35 1</ambient><diffuse>0.4 0.35 0.35 1</diffuse></material></visual></link></model>
    <model name="wall_stub"><static>true</static><pose>-3 -4 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.2 6 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 6 1</size></box></geometry>
      <material><ambient>0.4 0.35 0.35 1</ambient><diffuse>0.4 0.35 0.35 1</diffuse></material></visual></link></model>

    <!-- Drone (kinematic, gpu_lidar). Starts near the room centre. -->
    <model name="drone1">
      <pose>0 -3 0.5 0 0 0</pose>
      <link name="base_link">
        <inertial><mass>1.0</mass>
          <inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.02</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.4 0.4 0.15</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 0.4 0.15</size></box></geometry>
          <material><ambient>0.85 0.15 0.15 1</ambient><diffuse>0.85 0.15 0.15 1</diffuse></material></visual>
        <sensor name="lidar" type="gpu_lidar">
          <pose>0 0 0.1 0 0 0</pose>
          <topic>/model/drone1/scan</topic>
          <update_rate>10</update_rate><always_on>1</always_on><visualize>true</visualize>
          <lidar>
            <scan><horizontal><samples>360</samples><resolution>1</resolution>
              <min_angle>-3.141592653589793</min_angle><max_angle>3.141592653589793</max_angle></horizontal>
              <vertical><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></vertical></scan>
            <range><min>0.25</min><max>12.0</max><resolution>0.01</resolution></range>
          </lidar>
        </sensor>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/model/drone1/cmd_vel</topic>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame><robot_base_frame>drone1</robot_base_frame>
        <dimensions>3</dimensions><odom_topic>/model/drone1/odometry</odom_topic>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
    </model>
  </world>
</sdf>
